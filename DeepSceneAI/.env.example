# rules (lightweight/offline) or transformers (real pretrained model inference)
DEEPSCENE_INFERENCE_BACKEND=rules
DEEPSCENE_MOOD_MODEL=j-hartmann/emotion-english-distilroberta-base
DEEPSCENE_GENRE_MODEL=valhalla/distilbart-mnli-12-1
DEEPSCENE_DIALOGUE_MODEL=google/flan-t5-base
DEEPSCENE_IMAGE_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
DEEPSCENE_CORS_ORIGINS=http://localhost:8501
DEEPSCENE_API_KEY=
DEEPSCENE_REQUIRE_API_KEY=0
INSTALL_AI_DEPS=false
CADDY_DOMAIN=
LOG_LEVEL=INFO
